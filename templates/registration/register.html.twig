{% extends 'base.html.twig' %}

{% block title %}Créer un compte pour créer ou interagir avec des articles{% endblock %}

{% block body %}
    <h1>Créer un compte</h1>
    {# erreurs globales du formulaires #}
    {{ form_errors(registrationForm) }}
    {# Surcouche Front enlevée pour l'affichage des erreurs #}
    {{ form_start(registrationForm, { attr: { novalidate: 'novalidate' } }) }}
    {# Chaques erreurs des champs est gérés par les contraintes mises dans le RegistrationForumType #}
        {{ form_row(registrationForm.email) }}
        {# form_row permet d'afficher le label et les erreurs (au lieu de faire le bloc form label,widget et errors pour les inputs qu'on veut afficher(sauf si formulaire pour les champs complets)) #}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Password'
        }) }}
        {{ form_row(registrationForm.nom) }}
        {{ form_row(registrationForm.prenom) }}
        {{ form_row(registrationForm.photo) }}
        {{ form_row(registrationForm.agreeTerms) }}

        <button type="submit" class="btn">Register</button>
    {{ form_end(registrationForm) }}
{% endblock %}
