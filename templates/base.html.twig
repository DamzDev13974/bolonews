<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content={% block meta_description %}" Bolonews, le nouveau journal connecté et participatif. Partagez vos experiences et connaissances comme bon vous semble."{% endblock %}>
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="{{ asset('css/style.css')}}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}
    </head>
    <body>
        <header>
            <div class="top-container header-content">
                <div class="logo-header">
                    <a href="{{ path('app_home') }}" aria-label="Aller sur la page d'accueil" title="Aller sur la page d'accueil">Bolonews</a>
                </div>
                <nav>
                    <ul class="nav-header">
                        <li>
                            <a href="{{ path('app_home') }}" aria-label="Aller sur la page d'accueil" title="Aller sur la page d'accueil">Home</a>
                        </li>
                        <li>
                            <a href="{{ path('app_recherche') }}" aria-label="Aller sur la page Articles, permettant de faire des recherches d'articles" title="Aller sur la page Articles, permettant de faire des recherches d'articles">Articles</a>
                        </li>
                        <li>
                            <a href="" aria-label="Aller à la page contact" title="aller à la page contact">Contact</a>
                        </li>
                    </ul>
                </nav>
                <div class="cta-header">
                    {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_liste') }}">Mon espace {{ ux_icon('ph:user') }}</a>
                    <a href="{{ path('app_logout') }}">Me déconnecter</a>
                {% elseif app.user  %}
                    <a href="{{ path('app_liste') }}">Mon espace</a>
                    <a href="{{ path('app_logout') }}">Me déconnecter</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Se connecter</a>
                    <a href="{{ path('app_register') }}">M'inscrire</a>
                {% endif %}
                </div>
            </div>
        </header>
        <main>
            <section class="hero-content top-container">
                <a href="{{ path('app_home') }}" aria-label="Aller sur la page d'accueil" title="Aller sur la page d'accueil">Bolonews</a>
                <p>Les meilleures sauces pour les pâtes et de l'acualité sur le grill</p>
                <div class="separator"></div>
                    {% block hero %}
                    {% endblock %}
            </section>
            {% block body %}
            {% endblock %}
        </main>
        <footer>
            <div class="top-footer">
                <h3>Navigation : </h3>
                <nav>
                    <ul class="footer-nav">
                        <li>
                            <a href="{{ path('app_home') }}" aria-label="Aller sur la page d'accueil" title="Aller sur la page d'accueil">Home</a>
                        </li>
                        <li>
                            <a href="{{ path('app_recherche') }}" aria-label="Aller sur la page Articles, permettant de faire des recherches d'articles" title="Aller sur la page Articles, permettant de faire des recherches d'articles">Articles</a>
                        </li>
                        <li>
                            <a href="" aria-label="Aller à la page contact" title="aller à la page contact">Contact</a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="separator-footer"></div>
            <div class="bottom-footer">
                <div class="logo-footer">
                    <a href="{{ path('app_home') }}" aria-label="Aller sur la page d'accueil" title="Aller sur la page d'accueil">Bolonews</a>
                </div>
                <p>© 2026 Fait par Damien.E dans le cadre de la formation Webecom</p>
            </div>
        </footer>
    </body>
</html>
