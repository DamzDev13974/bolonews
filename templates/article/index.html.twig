{% extends 'base.html.twig' %}
{% block title %}Bolonews - Journal participatif et actualités pour vous {% endblock %}

{% block body %}
    <div class="small-container">
        <h1>Bienvenue sur Bolonews</h1>
        {# Message d'erreur suite redirection après contrainte de modification ou suppression non respectée #}
        {# Si le message est défini et que la variable existe et contient une vraie valeur #}
        {% if message is defined and message is not empty %}
            <div class="error-index">
                <p>{{message}}</p>
            </div>
        {% endif %}
        <section class="une">
            <h2>A la une !</h2>
                <div class="card-une">
                    {% for article in une %}
                        {% include 'article/_cardArticle.html.twig' %}
                    {% endfor %}
                </div>
            </section>
        <section class="last-articles">
            <h2>Dernières parutions</h2>
            <div class="four-last">
                {% for article in articles %}
                    {% include 'article/_cardArticle.html.twig' %}
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}
