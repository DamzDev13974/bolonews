<div class="card-article">
    <div class="img-card">
        <img src="{{ asset('img/article/' ~ article.photo)}}" alt="image du produit {{article.titre}}">
    </div>
    <div class="card-content">
        <div class="card-top">
            <p>{{article.categorie.libelle}}</p>
            {% if is_granted("ROLE_ADMIN") %}
                <a href="{{ path('app_admin_article_edit', {'id': article.id}) }}">Editer</a>
                {% if article.publie %}
                    <a href="{{ path('app_publier', {'id': article.id}) }}">Dépublier</a>
                {% else %}
                    <a href="{{ path('app_publier', {'id': article.id}) }}">Publier</a>
                {% endif %}
            {% elseif app.user and article.auteur == app.user %}
                <a href="{{ path('app_article_edit', {'id': article.id}) }}">Editer</a>
                {% if article.publie %}
                    <a href="{{ path('app_publier', {'id': article.id}) }}">Dépublier</a>
                {% else %}
                    <a href="{{ path('app_publier', {'id': article.id}) }}">Publier</a>
                {% endif %}
            {% endif %}
        </div>
        <h2 class="card-title">{{article.titre}}</h2>
        <div class="card-auteur">
            <p>{{article.auteur.nom}} {{article.auteur.prenom}}</p>
            <p>Le {{article.dateCreation | date("m/d/Y")}}</p>
        </div>
        <div class="card-chapeau">
            <p>{{article.chapeau}}</p>
            <a href="{{ path('app_article_show', {'id': article.id}) }}">Lire la suite</a>
        </div>
        <div class="card-cta">
            <a href="{{ path('ajouter_commentaire', {'id': article.id}) }}">Commenter {{article.commentaires|length }}</a>
            <a href="{{ path('app_like', {'id': article.id}) }}"> Liker {{ article.likeBy|length}}</a>
        </div>
    </div>
</div>