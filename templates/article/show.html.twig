{% extends 'base.html.twig' %}
{% block meta_description  %} Découvrez cet article sur Bolonews, consultez son contenu, les réactions des lecteurs et participez à la discussion. {% endblock %}
{% block title %}Détails de l'article {{ article.titre }} {% endblock %}

{% block body %}

    <div class="small-container">
        <section class="article-details">
            <div class="top-details">
                <p>{{ article.categorie.libelle }}</p>
                <p>{{ article.titre }}</p>
                <p>publié le : {{ article.dateCreation ? article.dateCreation|date('Y-m-d H:i:s') : '' }}</p>
            </div>
            <div class="img-card">
                <img src="{{ asset('img/article/' ~ article.photo)}}" alt="image de l'article {{article.titre}}">
            </div>
            <div class="content-details">
                <p>{{ article.chapeau }}</p>
                <p>{{ article.contenu }}</p>
            </div>
            <div class="cta-details">
                <div class="card-auteur">
                    <img src="{{ asset('img/' ~ article.auteur.photo)}}" alt="image de l'auteur {{article.auteur.nom}} {{article.auteur.prenom}}">
                    <p>{{article.auteur.nom}} {{article.auteur.prenom}}</p>
                </div>
                <div class="card-social">
                    <a href="{{ path('ajouter_commentaire', {'id': article.id}) }}">{{ ux_icon('ph:chat-circle') }} {{article.commentaires|length }}</a>
                    <a href="{{ path('app_like', {'id': article.id}) }}"> {{ ux_icon('ph:heart') }} {{ article.likeBy|length}}</a>
                </div>
            </div>
        </section>
        <div class="separator"></div>
        <section class="commentaire">
        
            <h2>Commentaires</h2>
            {% for commentaire in commentaires %}
                {% include 'commentaire/_divCommentaire.html.twig' %}
            {% endfor %}
            {% if app.user %}
                {% include 'commentaire/_formCommentaire.html.twig' %}
            {% endif %}
        </section>
    </div>
    
{% endblock %}
